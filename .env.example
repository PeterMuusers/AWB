# Login for luchtvaartmeteo.nl, used server-side by html/luchtvaartmeteo-proxy.php.
# Copy this file to .env (next to the html directory, so outside the web root:
# /var/www/.env on the Raspberry Pi) and fill in your own account.
# .env is ignored by git, so your credentials never end up in the repository.
# The same variables can also be set as real environment variables (e.g. in Docker),
# those take precedence over this file.
LVM_EMAIL=user@example.com
LVM_PASSWORD=0000000000

# KNMI Data Platform keys for the radar map (html/scripts/modules/radar.js via html/knmi-wms-proxy.php).
# Free, register at https://developer.dataplatform.knmi.nl/ (API catalog: "WMS" and "Open Data").
# Only the precipitation forecast (2 hours ahead) needs this key; the radar history and the
# satellite images are public. The Open Data key is used as a fallback for the WMS key.
KNMI_WMS_KEY=0000000000
KNMI_OPEN_DATA_KEY=0000000000

# Precipitation forecast from jumprun.nl, fetched server-side by html/jumprun-proxy.php.
# Both optional: JUMPRUN_URL overrides the default https://weer.jumprun.nl, JUMPRUN_API_KEY is sent
# as X-Api-Key header so jumprun.nl can restrict access to known boards.
# JUMPRUN_URL=https://weer.jumprun.nl
# JUMPRUN_API_KEY=0000000000
